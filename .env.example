# Copie para .env e preencha. O .env nunca entra no git.

# PostgreSQL local: postgresql://USUARIO:SENHA@localhost:5432/apuracao
# Neon: connection string do painel, com sslmode=verify-full (no lugar de require)
DATABASE_URL=postgresql://postgres:SENHA@localhost:5432/apuracao

# Segredos aleatórios com pelo menos 32 caracteres. Gere cada um com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
VOTO_TOKEN_SECRET=
