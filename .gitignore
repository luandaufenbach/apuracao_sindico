# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: segredos ficam fora do git; só o modelo entra
.env*
!.env.example

# planilhas reais têm dados pessoais e nunca entram no repositório
*.xlsx
*.xls

# claude code: permissões locais de cada máquina
.claude/settings.local.json

# lumen: imagens de referência de outra marca, fora do repositório
.claude/skills/lumen-design/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
